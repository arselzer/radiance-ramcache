 * but Q5_K (176-byte blocks), so those types read 16-bit words; Q5_K reads dwords. */
enum : int { GG_Q8_0 = 0, GG_Q5_K, GG_Q6_K, GG_IQ4_NL, GG_IQ2_XXS, GG_IQ1_S, GG_F32, GG_NTYPES };

typedef __attribute__((address_space(1))) const uint32_t* gg_gu32;
typedef __attribute__((address_space(1))) const r4d_u32x4* gg_gu128;

__device__ __forceinline__ uint32_t gg_u16(const uint8_t* p) { return ldg_u16((const uint16_t*)p); }
__device__ __forceinline__ uint32_t gg_d32a2(const uint8_t* p) {
    return gg_u16(p) | (gg_u16(p + 2) << 16);
}
__device__ __forceinline__ uint32_t gg_d32(const uint8_t* p) { return *(gg_gu32)(const void*)p; }
__device__ __forceinline__ uint32_t gg_byte(uint32_t w, int i) { return (w >> (8 * i)) & 0xffu; }
__device__ __forceinline__ int gg_sbyte(uint32_t w, int i) { return (int)(int8_t)(w >> (8 * i)); }

/* IEEE half -> float exactly, as lq::ggml::f16_to_f32 (subnormals, infinities, NaN payloads). */
__device__ __forceinline__ float gg_h2f(uint32_t h) {
    const uint32_t s = (h & 0x8000u) << 16, e = (h >> 10) & 0x1fu, m = h & 0x3ffu;
    const float sub = __uint_as_float(__float_as_uint((float)m * 0x1p-24f) | s);
    const uint32_t nb = e == 0x1fu ? (s | 0x7f800000u | (m << 13)) : (s | ((e + 112u) << 23) | (m << 13));
    return e == 0u ? sub : __uint_as_float(nb);
}

/* Rounded once to the output dtype as libref's stt does: bf16 RNE with a NaN kept quiet. */
__device__ __forceinline__ void gg_put(uint16_t* p, float v) { *p = (uint16_t)(bf16_hi_rne_nan(v) >> 16); }
__device__ __forceinline__ void gg_put(float* p, float v) { *p = v; }

template <int N, int I = 0, class F>
__device__ __forceinline__ void gg_for(F&& f) {
    if constexpr (I < N) {
        f(std::integral_constant<int, I>{});
        gg_for<N, I + 1>(f);
    }
}

/* ================================================================== the types
 *
 * Per type: QK values and BB bytes a block, UPB 32-value units a block, NR raw dwords a unit,
 * TB bytes of LDS table. load() reads unit u of the block at `b` into raw dwords; goff(u, G) is
 * where group G (8 consecutive values) of the unit starts in the block; dec<G>() turns the raw
 * dwords into the group's eight f32 values, each by llama.cpp's formula. */
template <int T> struct Gg;

/* Q8_0: d (f16), qs[32]. y = qs * d. */
template <> struct Gg<GG_Q8_0> {
    static constexpr int QK = 32, BB = 34, UPB = 1, NR = 9, TB = 0;
    __device__ static __forceinline__ void load(const uint8_t* b, int, uint32_t* r) {
        r[0] = gg_u16(b);
#pragma unroll
        for (int i = 0; i < 8; ++i) r[1 + i] = gg_d32a2(b + 2 + 4 * i);
    }
    __device__ static __forceinline__ int goff(int, int g) { return 8 * g; }
    template <int G>
    __device__ static __forceinline__ void dec(const uint32_t* r, int, const void*, float* w) {
        const float d = gg_h2f(r[0]);
#pragma unroll
        for (int t = 0; t < 8; ++t) w[t] = (float)gg_sbyte(r[1 + 2 * G + t / 4], t % 4) * d;
    }
};

/* Q5_K: d, dmin, scales[12], qh[32], qs[128]. Chunk j of 64: d1 = d * sc, m1 = dmin * m from
 * scale_min_k4(2j + hi); y = d1 * (nibble + 16 * qh bit (2j + hi)) - m1. A unit is one l-range of
 * 8 (l0 = 8 (u & 3)) over the chunk pair jp = u >> 2: groups (j = 2jp + G/2, hi = G & 1). */
template <> struct Gg<GG_Q5_K> {
    static constexpr int QK = 256, BB = 176, UPB = 8, NR = 10, TB = 0;
    __device__ static __forceinline__ void load(const uint8_t* b, int u, uint32_t* r) {
        const int jp = u >> 2, l0 = 8 * (u & 3);
        r[0] = gg_d32(b);
        r[1] = gg_d32(b + 4);
        r[2] = gg_d32(b + 8);
        r[3] = gg_d32(b + 12);
        r[4] = gg_d32(b + 16 + l0);
        r[5] = gg_d32(b + 20 + l0);
        r[6] = gg_d32(b + 48 + 64 * jp + l0);
        r[7] = gg_d32(b + 52 + 64 * jp + l0);
        r[8] = gg_d32(b + 80 + 64 * jp + l0);
        r[9] = gg_d32(b + 84 + 64 * jp + l0);
    }
    __device__ static __forceinline__ int goff(int u, int g) {
        return 128 * (u >> 2) + 64 * (g >> 1) + 32 * (g & 1) + 8 * (u & 3);
    }
    template <int G>
    __device__ static __forceinline__ void dec(const uint32_t* r, int u, const void*, float* w) {
        constexpr int JL = G >> 1, HI = G & 1;
        const int jp = u >> 2;
        const float d = gg_h2f(r[0] & 0xffffu), dmin = gg_h2f(r[0] >> 16);
        /* scale_min_k4(is = 4 jp + G): q[G], q[G + 4], q[G + 8] are byte G of r[1], r[2], r[3]. */
        const uint32_t qa = gg_byte(r[1], G), qb = gg_byte(r[2], G), qc = gg_byte(r[3], G);
        const uint32_t sc = jp ? ((qc & 0xFu) | ((qa >> 6) << 4)) : (qa & 63u);
        const uint32_t mn = jp ? ((qc >> 4) | ((qb >> 6) << 4)) : (qb & 63u);
        const float d1 = d * (float)sc, m1 = dmin * (float)mn;
        const int hs = 4 * jp + G;            /* the qh bit: 2j + hi */
#pragma unroll
        for (int t = 0; t < 8; ++t) {
            const uint32_t qlb = gg_byte(r[6 + 2 * JL + t / 4], t % 4);
            const uint32_t q = HI ? (qlb >> 4) : (qlb & 0xFu);
            const uint32_t hb = (gg_byte(r[4 + t / 4], t % 4) >> hs) & 1u;
            w[t] = d1 * (float)(int)(q + (hb << 4)) - m1;
        }
    }
};

/* Q6_K: ql[128], qh[64], scales[16] (int8), d. Half h of 128: y[l + 32q] =
 * d * sc[is + 2q] * (q6 - 32), q6 = ql nibble | 2 qh bits << 4. A unit is one l-range of 8
 * (l0 = 8 (u & 3)) of half h = u >> 2 over the four quarters q (the groups). */
template <> struct Gg<GG_Q6_K> {
    static constexpr int QK = 256, BB = 210, UPB = 8, NR = 9, TB = 0;
    __device__ static __forceinline__ void load(const uint8_t* b, int u, uint32_t* r) {
        const int h = u >> 2, l0 = 8 * (u & 3);
        r[0] = gg_d32a2(b + 64 * h + l0);
        r[1] = gg_d32a2(b + 64 * h + l0 + 4);
        r[2] = gg_d32a2(b + 64 * h + 32 + l0);
        r[3] = gg_d32a2(b + 64 * h + 36 + l0);
        r[4] = gg_d32a2(b + 128 + 32 * h + l0);
        r[5] = gg_d32a2(b + 132 + 32 * h + l0);
        r[6] = gg_d32a2(b + 192 + 8 * h);
        r[7] = gg_d32a2(b + 196 + 8 * h);
        r[8] = gg_u16(b + 208);
    }
    __device__ static __forceinline__ int goff(int u, int g) {
        return 128 * (u >> 2) + 32 * g + 8 * (u & 3);
    }
    template <int G>
    __device__ static __forceinline__ void dec(const uint32_t* r, int u, const void*, float* w) {
        const int is = (u & 3) >> 1;
        const int sc = gg_sbyte(G < 2 ? r[6] : r[7], 2 * (G & 1) + is);
        const float ds = gg_h2f(r[8]) * (float)sc;
#pragma unroll
        for (int t = 0; t < 8; ++t) {
            const uint32_t qlb = gg_byte(r[(G & 1) * 2 + t / 4], t % 4);
            const uint32_t nib = G >= 2 ? (qlb >> 4) : (qlb & 0xFu);
            const uint32_t hb = (gg_byte(r[4 + t / 4], t % 4) >> (2 * G)) & 3u;
            w[t] = ds * (float)((int)(nib | (hb << 4)) - 32);
        }
    }
};

/* IQ4_NL: d, qs[16]. y[j] = d * kvalues[qs[j] & 15], y[j + 16] = d * kvalues[qs[j] >> 4]. */
template <> struct Gg<GG_IQ4_NL> {
    static constexpr int QK = 32, BB = 18, UPB = 1, NR = 5, TB = 64;
    __device__ static __forceinline__ void load(const uint8_t* b, int, uint32_t* r) {
        r[0] = gg_u16(b);
#pragma unroll
        for (int i = 0; i < 4; ++i) r[1 + i] = gg_d32a2(b + 2 + 4 * i);
    }
    __device__ static __forceinline__ int goff(int, int g) { return 8 * g; }
    template <int G>
    __device__ static __forceinline__ void dec(const uint32_t* r, int, const void* tab, float* w) {
        const float* kv = (const float*)tab;
        const float d = gg_h2f(r[0]);
#pragma unroll
        for (int t = 0; t < 8; ++t) {
            const uint32_t by = gg_byte(r[1 + 2 * (G & 1) + t / 4], t % 4);
            w[t] = d * kv[G >= 2 ? (by >> 4) : (by & 0xFu)];
        }
    }
};

/* IQ2_XXS: d, qs[32] u16. Sub-block ib: aux0 = four grid indices, aux1 = 4 x 7 sign bits and the
 * scale; db = d * (0.5 + (aux1 >> 28)) * 0.25; y = db * grid * (+-1). */
template <> struct Gg<GG_IQ2_XXS> {
    static constexpr int QK = 256, BB = 66, UPB = 8, NR = 3, TB = 2048;
    __device__ static __forceinline__ void load(const uint8_t* b, int u, uint32_t* r) {
        r[0] = gg_u16(b);
        r[1] = gg_d32a2(b + 2 + 8 * u);
        r[2] = gg_d32a2(b + 6 + 8 * u);
    }
    __device__ static __forceinline__ int goff(int u, int g) { return 32 * u + 8 * g; }
    template <int G>
    __device__ static __forceinline__ void dec(const uint32_t* r, int, const void* tab, float* w) {
        const uint32_t* grid = (const uint32_t*)tab;
        const float db = gg_h2f(r[0]) * (0.5f + (float)(r[2] >> 28)) * 0.25f;
        const uint32_t gi = gg_byte(r[1], G);
        const uint32_t lo = grid[2 * gi], hi = grid[2 * gi + 1];
        /* ksigns_iq2xs[s] = s with bit 7 the parity of s (an even count of minus signs). */
        const uint32_t sx = (r[2] >> (7 * G)) & 127u;
        const uint32_t sg = sx | ((__builtin_popcount(sx) & 1u) << 7);
#pragma unroll
        for (int t = 0; t < 8; ++t) {
            const float m = db * (float)gg_byte(t < 4 ? lo : hi, t % 4);
            w[t] = ((sg >> t) & 1u) ? -m : m;
        }
    }
};

/* IQ1_S: d, qs[32], qh[8] u16. Sub-block ib: dl = d * (2 ((qh >> 12) & 7) + 1), delta = -+0.125
 * by qh's top bit, grid index qs | 3 qh bits << 8; y = dl * (grid + delta). The table holds
 * grid + 1 (0, 1, 2), so grid + delta = byte + (delta - 1), exact either way. */
template <> struct Gg<GG_IQ1_S> {
    static constexpr int QK = 256, BB = 50, UPB = 8, NR = 3, TB = 16384;
    __device__ static __forceinline__ void load(const uint8_t* b, int u, uint32_t* r) {
        r[0] = gg_u16(b);
        r[1] = gg_d32a2(b + 2 + 4 * u);
        r[2] = gg_u16(b + 34 + 2 * u);
    }
    __device__ static __forceinline__ int goff(int u, int g) { return 32 * u + 8 * g; }
    template <int G>
    __device__ static __forceinline__ void dec(const uint32_t* r, int, const void* tab, float* w) {
        const uint32_t* grid = (const uint32_t*)tab;
        const uint32_t qh = r[2];
        const float dl = gg_h2f(r[0]) * (float)(int)(2 * ((qh >> 12) & 7u) + 1);
        const float c = (qh & 0x8000u) ? -1.125f : -0.875f;
        const uint32_t gi = gg_byte(r[1], G) | (((qh >> (3 * G)) & 7u) << 8);
        const uint32_t lo = grid[2 * gi], hi = grid[2 * gi + 1];
#pragma unroll
        for (int t = 0; t < 8; ++t) w[t] = dl * ((float)gg_byte(t < 4 ? lo : hi, t % 4) + c);
    }
};

/* The float logical form: 32 values a unit, read as they are. */
template <> struct Gg<GG_F32> {
    static constexpr int QK = 32, BB = 128, UPB = 1, NR = 32, TB = 0;
    __device__ static __forceinline__ void load(const uint8_t* b, int, uint32_t* r) {
#pragma unroll
        for (int i = 0; i < 32; ++i) r[i] = gg_d32(b + 4 * i);
    }
    __device__ static __forceinline__ int goff(int, int g) { return 8 * g; }
    template <int G>
    __device__ static __forceinline__ void dec(const uint32_t* r, int, const void*, float* w) {
#pragma unroll
        for (int t = 0; t < 8; ++t) w[t] = __uint_as_float(r[8 * G + t]);
    }
};

/* The type's table into LDS at `lds`, by the whole block; the caller barriers. */
template <int T>
__device__ __forceinline__ void gg_load_table(uint8_t* lds) {
    constexpr int TB = Gg<T>::TB;
    if constexpr (TB > 0) {
        const r4d_u32x4* src = (T == GG_IQ1_S)    ? (const r4d_u32x4*)(const void*)kGgIq1sGridP1
                             : (T == GG_IQ2_XXS) ? (const r4d_u32x4*)(const void*)kGgIq2xxsGrid
                                                 : (const r4d_u32x4*)(const void*)kGgIq4nlValues;
        r4d_u32x4* dst = (r4d_u32x4*)lds;
        for (int i = (int)threadIdx.x; i < TB / 16; i += (int)blockDim.x) dst[i] = src[i];
    }
}

/* Eight bf16 activations widened to f32 (exact). `al`: the address is 16-byte aligned. */
__device__ __forceinline__ void gg_x8(const uint16_t* p, bool al, float* v) {
    uint32_t q[4];
    if (al) {
        const r4d_u32x4 t = *(gg_gu128)(const void*)p;
        q[0] = t[0]; q[1] = t[1]; q[2] = t[2]; q[3] = t[3];
    } else {
#pragma unroll
        for (int i = 0; i < 4; ++i) q[i] = ldg_u16(p + 2 * i) | (ldg_u16(p + 2 * i + 1) << 16);
    }
#pragma unroll
    for (int i = 0; i < 4; ++i) { v[2 * i] = bf16w_lo(q[i]); v[2 * i + 1] = bf16w_hi(q[i]); }
}

/* The same eight bf16 as four bf16-pair dwords, unconverted. */
__device__ __forceinline__ void gg_x8raw(const uint16_t* p, bool al, uint32_t* q) {
    if (al) {
        const r4d_u32x4 t = *(gg_gu128)(const void*)p;
        q[0] = t[0]; q[1] = t[1]; q[2] = t[2]; q[3] = t[3];
    } else {
#pragma unroll
        for (int i = 0; i < 4; ++i) q[i] = ldg_u16(p + 2 * i) | (ldg_u16(p + 2 * i + 1) << 16);
    }
}

/* Expert e's rows of the sorted order as libref assigns them: its binary search gives row i to
 * the last expert whose offset is <= i (expert 0 below off[0], the last one up to T), which for
 * moe_scatter's non-decreasing offsets is [off[e], off[e + 1]) with those two ends opened. */
__device__ __forceinline__ void gg_range(const int32_t* off, int e, int ne, int T, int* s, int* t) {
    int a = e == 0 ? 0 : off[e];
    int b = e == ne - 1 ? T : off[e + 1];
    a = a < 0 ? 0 : (a > T ? T : a);
    b = b < a ? a : (b > T ? T : b);
    *s = a;
    *t = b;
}

/* The activation row a sorted slot reads (a_order "token": sorted / top_k, "sorted": the slot),
 * or -1 for a dropped slot or a token past `a`: a row of zeros, as libref writes it. */
__device__ __forceinline__ int gg_moe_tok(const int32_t* sorted, int i, int top_k, int a_sorted, int AR) {
    const int flat = sorted[i];
    if (flat < 0) return -1;
    const int tok = a_sorted ? i : flat / top_k;
    return tok < AR ? tok : -1;
}

/* ================================================================== gemv (decode) */
constexpr int kGgWaves = 8;
constexpr int kGgThreads = 256;
constexpr int kGgXM = 8;                 /* activation rows a pass */
constexpr int kGgMaxExpert = 1024;

struct GgGemvArgs {
    const uint16_t* x;
    long long x_ld;                      /* elements */
    const uint8_t* w;                    /* plain weight, or stacked experts */
    const uint8_t* const* wtab;          /* expert table (device pointers), or null */
    long long w_ld;                      /* bytes a weight row */
    long long w_es;                      /* bytes an expert (stacked) */
    void* y;
    long long y_ld;
    const int32_t* sorted;
    const int32_t* off;
    int M;                               /* GEMM: activation rows; MoE: output rows T */
    int N, K;
    int XM;                              /* activation rows a pass, <= kGgXM */
    int XLM;                             /* rows whose whole K fits the LDS buffer (0..XM) */
    int XR;                              /* floats a whole staged row (K plus its pad) */
    int KC;                              /* values a chunk when the pass's rows do not fit whole */
    int rgpi;                            /* row groups a work item */
    int ipe;                             /* work items an expert (GEMM: in all) */
    int n_expert, top_k, a_sorted, AR, x_al;
    int live_off, x_off;                 /* LDS byte offsets of the live list and the rows */
};

/* A staged row: its values with 4 floats of pad after every 32, so the eight lanes of a block's
 * sub-blocks read different banks. */
__device__ __forceinline__ int gg_xphys(int kk) { return kk + ((kk >> 5) << 2); }

/* The activation row a pass row reads (null: a dropped slot, a row of zeros). */
template <bool MOE>
__device__ __forceinline__ const uint16_t* gg_xrow(const GgGemvArgs& A, int i) {
    int row;
    if constexpr (MOE) row = gg_moe_tok(A.sorted, i, A.top_k, A.a_sorted, A.AR);
    else row = i;
    return row >= 0 ? A.x + (long long)row * A.x_ld : nullptr;
}

/* Values [k0, k1) of rows p0 .. p0 + mc - 1 widened into LDS by the block, `xr` floats a row. */
template <bool MOE>
__device__ __forceinline__ void gg_stage(const GgGemvArgs& A, float* xs, int p0, int mc, int k0,
                                         int k1, int xr) {
    const int c8n = (k1 - k0) >> 3;
    for (int idx = (int)threadIdx.x; idx < mc * c8n; idx += kGgThreads) {
        const int m = idx / c8n, kk = (idx - m * c8n) << 3;
        const uint16_t* xrow = gg_xrow<MOE>(A, p0 + m);
        float v[8];
        if (xrow) {
            gg_x8(xrow + k0 + kk, A.x_al != 0, v);
        } else {
#pragma unroll
            for (int t = 0; t < 8; ++t) v[t] = 0.0f;
        }
        float* d = xs + m * xr + gg_xphys(kk);
        *(float4*)d = make_float4(v[0], v[1], v[2], v[3]);
        *(float4*)(d + 4) = make_float4(v[4], v[5], v[6], v[7]);
    }
}

/* One unit of RPW rows into the sums; the staged rows hold values from kb on, xr floats a row. */
template <int T, int RPW>
__device__ __forceinline__ void gg_unit(const uint32_t (&raw)[RPW][Gg<T>::NR], int U,
                                        const float* xs, int xr, int kb, int mc, const void* tab,
                                        const bool (&ok)[RPW], float (&acc)[RPW][kGgXM]) {
    using Q = Gg<T>;
    const int b = U / Q::UPB, u = U - b * Q::UPB;
    gg_for<4>([&](auto gi) {
        constexpr int G = decltype(gi)::value;
        const int kk = b * Q::QK + Q::goff(u, G) - kb;
        float w[RPW][8];
#pragma unroll
        for (int r = 0; r < RPW; ++r)
            if (ok[r]) Q::template dec<G>(raw[r], u, tab, w[r]);
#pragma unroll
        for (int m = 0; m < kGgXM; ++m) {
            if (m < mc) {
                const float* xp = xs + m * xr + gg_xphys(kk);
                const float4 a = *(const float4*)xp;
                const float4 c = *(const float4*)(xp + 4);
                const float xv[8] = { a.x, a.y, a.z, a.w, c.x, c.y, c.z, c.w };
#pragma unroll
                for (int r = 0; r < RPW; ++r)
                    if (ok[r]) {
#pragma unroll
                        for (int t = 0; t < 8; ++t) acc[r][m] += xv[t] * w[r][t];
                    }
            }
        }
    });
}

/* Units [U0, U1) of rows n0.. into the sums: lane = unit mod 32 (U0 a multiple of 32), UF units
 * a lane in flight (eight for the three-word I-quant units, two for the K-quants' and q8_0's). A
 * lane's units and their order are the same whether K is staged whole or in chunks of a multiple
 * of 32 units, so the bits do not depend on M or on the path. */
template <int T, int RPW>
__device__ __forceinline__ void gg_row(const GgGemvArgs& A, const uint8_t* wb, const float* xs,
                                       int xr, int kb, int U0, int U1, int n0, int mc, int lane,
                                       const void* tab, float (&acc)[RPW][kGgXM]) {
    using Q = Gg<T>;
    constexpr int UF = Q::NR <= 4 ? (RPW == 1 ? 8 : 4) : 2;
    bool ok[RPW];
    const uint8_t* wr[RPW];
#pragma unroll
    for (int r = 0; r < RPW; ++r) {
        ok[r] = n0 + r < A.N;
        wr[r] = wb + (long long)(ok[r] ? n0 + r : 0) * A.w_ld;
    }
    for (int U = U0 + lane; U < U1; U += 32 * UF) {
        uint32_t raw[UF][RPW][Q::NR];
        gg_for<UF>([&](auto fi) {
            constexpr int F = decltype(fi)::value;
            const int V = U + 32 * F;
            if (V < U1) {
                const int b = V / Q::UPB;
#pragma unroll
                for (int r = 0; r < RPW; ++r)
                    if (ok[r]) Q::load(wr[r] + (long long)b * Q::BB, V - b * Q::UPB, raw[F][r]);
            }
        });
        gg_for<UF>([&](auto fi) {
            constexpr int F = decltype(fi)::value;
            const int V = U + 32 * F;
            if (V < U1) gg_unit<T, RPW>(raw[F], V, xs, xr, kb, mc, tab, ok, acc);
        });
    }
}

template <int T, int RPW, bool MOE, typename OT>
__global__ __launch_bounds__(kGgThreads) void gg_gemv_kernel(GgGemvArgs A) {
    using Q = Gg<T>;
    extern __shared__ __attribute__((aligned(16))) uint8_t gg_smem[];
    __shared__ int s_nlive;
    const int tid = (int)threadIdx.x, lane = tid & 31, wave = tid >> 5;
    gg_load_table<T>(gg_smem);
    const void* tab = gg_smem;
    int* live = (int*)(gg_smem + A.live_off);
    float* xs = (float*)(gg_smem + A.x_off);
    constexpr int RG = kGgWaves * RPW;
    const int nrg = (A.N + RG - 1) / RG;
    const int UK = A.K / Q::QK * Q::UPB;              /* units a row */
    const int XRC = A.KC + A.KC / 8;                  /* floats a chunked row */
    int n_items = A.ipe;
    if constexpr (MOE) {
        /* The experts with rows, in ascending order. */
        if (wave == 0) {
            int cnt = 0;
            for (int e0 = 0; e0 < A.n_expert; e0 += 32) {
                const int e = e0 + lane;
                int s = 0, t = 0;
                if (e < A.n_expert) gg_range(A.off, e, A.n_expert, A.M, &s, &t);
                const bool nz = e < A.n_expert && t > s;
                const uint32_t bal = __builtin_amdgcn_ballot_w32(nz);
                if (nz) live[cnt + __builtin_popcount(bal & ((1u << lane) - 1u))] = e;
                cnt += __builtin_popcount(bal);
            }
            if (lane == 0) s_nlive = cnt;
        }
        __syncthreads();
        n_items = s_nlive * A.ipe;
    } else {
        __syncthreads();
    }
    int cur_e = -1, cur_p = -1;                       /* the rows the LDS buffer holds whole */
    for (int it = (int)blockIdx.x; it < n_items; it += (int)gridDim.x) {
        int e = 0, ri = it, rs = 0, re = A.M;
        const uint8_t* wb = A.w;
        if constexpr (MOE) {
            e = live[it / A.ipe];
            ri = it - (it / A.ipe) * A.ipe;
            gg_range(A.off, e, A.n_expert, A.M, &rs, &re);
            wb = A.wtab ? A.wtab[e] : A.w + (long long)e * A.w_es;
        }
        const int rg0 = ri * A.rgpi, rg1 = min(rg0 + A.rgpi, nrg);
        for (int p0 = rs; p0 < re; p0 += A.XM) {
            const int mc = min(A.XM, re - p0);
            const bool whole = mc <= A.XLM;            /* block-uniform */
            if (whole && (cur_e != e || cur_p != p0)) {
                lds_barrier();
                gg_stage<MOE>(A, xs, p0, mc, 0, A.K, A.XR);
                lds_barrier();
                cur_e = e;
                cur_p = p0;
            }
            /* The pass's live rows (a dropped slot writes zeros), read once, not a row group. */
            uint32_t livem = (1u << mc) - 1u;
            if constexpr (MOE) {
                livem = 0;
                for (int m = 0; m < mc; ++m)
                    if (gg_moe_tok(A.sorted, p0 + m, A.top_k, A.a_sorted, A.AR) >= 0) livem |= 1u << m;
            }
            for (int rg = rg0; rg < rg1; ++rg) {
                const int n0 = rg * RG + wave * RPW;
                const bool active = n0 < A.N;          /* wave-uniform */
                float acc[RPW][kGgXM];
#pragma unroll
                for (int r = 0; r < RPW; ++r)
#pragma unroll
                    for (int m = 0; m < kGgXM; ++m) acc[r][m] = 0.0f;
                if (whole) {
                    if (active) gg_row<T, RPW>(A, wb, xs, A.XR, 0, 0, UK, n0, mc, lane, tab, acc);
                } else {
                    /* The pass's rows do not fit whole: K in chunks, restaged a row group (every
                     * wave takes part in the barriers). */
                    for (int k0 = 0; k0 < A.K; k0 += A.KC) {
                        const int k1 = min(k0 + A.KC, A.K);
                        lds_barrier();
                        gg_stage<MOE>(A, xs, p0, mc, k0, k1, XRC);
                        lds_barrier();
                        if (active)
                            gg_row<T, RPW>(A, wb, xs, XRC, k0, k0 / Q::QK * Q::UPB, k1 / Q::QK * Q::UPB,
                                           n0, mc, lane, tab, acc);
                    }
                    cur_e = -1;
                }
                if (!active) continue;
#pragma unroll
                for (int r = 0; r < RPW; ++r) {
                    const int n = n0 + r;
                    if (n >= A.N) continue;
#pragma unroll
                    for (int m = 0; m < kGgXM; ++m) {
                        if (m >= mc) continue;
                        const float v = r4d_wave_sum(acc[r][m]);
                        if (lane == 0)
                            gg_put((OT*)A.y + (long long)(p0 + m) * A.y_ld + n, ((livem >> m) & 1u) ? v : 0.0f);
                    }
                }
            }
        }
    }
}

/* ================================================================== tiled (prefill) */
constexpr int kTN = 128, kTP = 132;   /* tile columns (weight rows), LDS row floats of Ws */

struct GgTiledArgs {
    const uint16_t* x;
    long long x_ld;
    const uint8_t* w;
    const uint8_t* const* wtab;
    long long w_ld, w_es;
    void* y;
    long long y_ld;
    const int32_t* sorted;
    const int32_t* off;
    int M, N, K;                         /* MoE: M is T, the output rows */
    int n_expert, top_k, a_sorted, AR, x_al, tab_bytes;
};

/* BM activation rows x 128 weight rows a block. BM 128: 8 x 8 outputs a thread; BM 32: 4 x 4. Each
 * output is the same chain at either height (slabs in order, the slab's 32 values in order), so
 * the bits do not depend on BM. */
template <int T, int BM, bool MOE, typename OT>
__global__ __launch_bounds__(kGgThreads) void gg_tiled_kernel(GgTiledArgs A) {
    using Q = Gg<T>;
    static_assert(BM == 32 || BM == 128, "a tile is 32 or 128 rows");
    constexpr int TM = BM == 128 ? 8 : 4, TN = BM == 128 ? 8 : 4;
    constexpr int TXN = kTN / TN;                   /* threads across the columns */
    constexpr int XP = BM + 4;                      /* LDS row floats of Xs */
    extern __shared__ __attribute__((aligned(16))) uint8_t gg_smem[];
    __shared__ int s_e, s_r0, s_r1;
    __shared__ int s_tok[BM];
    const int tid = (int)threadIdx.x, lane = tid & 31, wave = tid >> 5;
    gg_load_table<T>(gg_smem);
    const void* tab = gg_smem;
    float* Ws = (float*)(gg_smem + A.tab_bytes);  /* [32][kTP]: slab value, weight row */
    float* Xs = Ws + 32 * kTP;                      /* [32][XP]: slab value, activation row */
    int e = 0, r0, r1;
    if constexpr (MOE) {
        /* Slot blockIdx.x -> (expert, its tile): the experts' tile counts scanned a wave of 32 at
         * a time. */
        if (wave == 0) {
            if (lane == 0) s_e = -1;
            const uint32_t slot = blockIdx.x;
            uint32_t base = 0;
            for (int e0 = 0; e0 < A.n_expert; e0 += 32) {
                const int ee = e0 + lane;
                int s = 0, t = 0;
                if (ee < A.n_expert) gg_range(A.off, ee, A.n_expert, A.M, &s, &t);
                const uint32_t tiles = (uint32_t)((t - s + BM - 1) / BM);
                const uint32_t inc = r4d_wave_prefix_u32(tiles, lane);
                const uint32_t tot = (uint32_t)__builtin_amdgcn_readlane((int)inc, 31);
                if (slot < base + tot) {
                    if (slot >= base + inc - tiles && slot < base + inc) {
                        s_e = ee;
                        s_r0 = s + (int)(slot - (base + inc - tiles)) * BM;
                        s_r1 = min(s_r0 + BM, t);
                    }
                    break;
                }
                base += tot;
            }
        }
        __syncthreads();
        e = s_e;
        if (e < 0) return;
        r0 = s_r0;
        r1 = s_r1;
    } else {
        r0 = (int)blockIdx.x * BM;
        r1 = min(r0 + BM, A.M);
    }
    if (tid < BM) {
        const int i = r0 + tid;
        int tk = -1;
        if (i < r1) {
            if constexpr (MOE) tk = gg_moe_tok(A.sorted, i, A.top_k, A.a_sorted, A.AR);
            else tk = i;
        }
        s_tok[tid] = tk;
    }
    __syncthreads();

    const int n0 = (int)blockIdx.y * kTN;
    const uint8_t* wb = A.w;
    if constexpr (MOE) wb = A.wtab ? A.wtab[e] : A.w + (long long)e * A.w_es;
    const int S = A.K / Q::QK * Q::UPB;
    /* Waves 0..3 decode a weight row each a slab, the next BM threads widen an activation row
     * each. */
    const bool wrole = tid < kTN;
    const bool xrole = tid >= kTN && tid < kTN + BM;
    const int ri = wrole ? tid : (xrole ? tid - kTN : 0);
    const bool nok = n0 + ri < A.N;
    const uint8_t* wrow = wb + (long long)(nok ? n0 + ri : 0) * A.w_ld;
    const int tokr = xrole ? s_tok[ri] : -1;
    const uint16_t* xrow = A.x + (long long)(tokr >= 0 ? tokr : 0) * A.x_ld;
    /* One prefetch register set for both roles: a unit's raw words, or four groups of eight bf16
     * (four dwords each), so the live set across the slab's multiply-adds is the larger, not the
     * sum. */
    constexpr int PF = Q::NR > 16 ? Q::NR : 16;
    uint32_t pf[PF];
    auto prefetch = [&](int s) {
        const int b = s / Q::UPB, u = s - b * Q::UPB;
        if (wrole) {
            if (nok) Q::load(wrow + (long long)b * Q::BB, u, pf);
        } else if (tokr >= 0) {
            gg_for<4>([&](auto gi) {
                constexpr int G = decltype(gi)::value;
                gg_x8raw(xrow + b * Q::QK + Q::goff(u, G), A.x_al != 0, pf + 4 * G);
            });
        }
    };
    float acc[TM][TN];
#pragma unroll
    for (int i = 0; i < TM; ++i)
#pragma unroll
        for (int j = 0; j < TN; ++j) acc[i][j] = 0.0f;
    const int ty = tid / TXN, tx = tid % TXN;
    prefetch(0);
    for (int s = 0; s < S; ++s) {
        const int u = s - (s / Q::UPB) * Q::UPB;
        if (wrole) {
            gg_for<4>([&](auto gi) {
                constexpr int G = decltype(gi)::value;
                float w[8];
                if (nok) {
                    Q::template dec<G>(pf, u, tab, w);
                } else {
#pragma unroll
                    for (int t = 0; t < 8; ++t) w[t] = 0.0f;
                }
#pragma unroll
                for (int t = 0; t < 8; ++t) Ws[(8 * G + t) * kTP + ri] = w[t];
            });
        } else if (xrole) {
#pragma unroll
            for (int i = 0; i < 16; ++i) {
                const uint32_t q = tokr >= 0 ? pf[i] : 0u;
                Xs[(2 * i) * XP + ri] = bf16w_lo(q);
                Xs[(2 * i + 1) * XP + ri] = bf16w_hi(q);
            }
        }
        lds_barrier();
        if (s + 1 < S) prefetch(s + 1);
#pragma unroll 2
        for (int kk = 0; kk < 32; ++kk) {
            float av[TM], bv[TN];
#pragma unroll
            for (int i = 0; i < TM; i += 4) {
                const float4 v = *(const float4*)(Xs + kk * XP + ty * TM + i);
                av[i] = v.x; av[i + 1] = v.y; av[i + 2] = v.z; av[i + 3] = v.w;
            }
#pragma unroll
            for (int j = 0; j < TN; j += 4) {
                const float4 v = *(const float4*)(Ws + kk * kTP + tx * TN + j);
                bv[j] = v.x; bv[j + 1] = v.y; bv[j + 2] = v.z; bv[j + 3] = v.w;
            }
#pragma unroll
            for (int i = 0; i < TM; ++i)
#pragma unroll
                for (int j = 0; j < TN; ++j) acc[i][j] += av[i] * bv[j];
        }
        lds_barrier();
    }
#pragma unroll
    for (int i = 0; i < TM; ++i) {
        const int lr = ty * TM + i, row = r0 + lr;
        if (row >= r1) continue;
        const bool live_row = s_tok[lr] >= 0;
        OT* yr = (OT*)A.y + (long long)row * A.y_ld;
#pragma unroll
        for (int j = 0; j < TN; ++j) {
            const int n = n0 + tx * TN + j;
            if (n < A.N) gg_put(yr + n, live_row ? acc[i][j] : 0.0f);
        }
    }
}

/* ================================================================== embed_lookup */
template <int T>
__global__ __launch_bounds__(kGgThreads) void gg_embed_kernel(const int32_t* tok, const uint8_t* w,
                                                              long long w_ld, uint16_t* x,
                                                              long long x_ld, int M, int E, int V,
                                                              long long voff, float mult) {
    using Q = Gg<T>;
    extern __shared__ __attribute__((aligned(16))) uint8_t gg_smem[];
    gg_load_table<T>(gg_smem);
    __syncthreads();
    const void* tab = gg_smem;
    const int nU = E / Q::QK * Q::UPB;
    for (int m = (int)blockIdx.x; m < M; m += (int)gridDim.x) {
        const long long id = (long long)tok[m] - voff;
        uint16_t* xr = x + (long long)m * x_ld;
        if (id < 0 || id >= V) {
            for (int k = (int)threadIdx.x; k < E; k += kGgThreads) xr[k] = 0;
            continue;
        }
        const uint8_t* wr = w + id * w_ld;
        for (int U = (int)threadIdx.x; U < nU; U += kGgThreads) {
            const int b = U / Q::UPB, u = U - b * Q::UPB;
            uint32_t raw[Q::NR];
            Q::load(wr + (long long)b * Q::BB, u, raw);
            gg_for<4>([&](auto gi) {
                constexpr int G = decltype(gi)::value;
                float v[8];
                Q::template dec<G>(raw, u, tab, v);
                uint16_t* d = xr + b * Q::QK + Q::goff(u, G);
#pragma unroll
                for (int t = 0; t < 8; ++t) gg_put(d + t, v[t] * mult);
            });
        }
    }
}

/* ================================================================== host side */
struct GgType {
    const char* name;
    int t, qk, bb, tb;
};
constexpr GgType kGgTypes[] = {
    { "q8_0", GG_Q8_0, 32, 34, 0 },        { "q5_K", GG_Q5_K, 256, 176, 0 },
    { "q6_K", GG_Q6_K, 256, 210, 0 },      { "iq4_nl", GG_IQ4_NL, 32, 18, 64 },
    { "iq2_xxs", GG_IQ2_XXS, 256, 66, 2048 }, { "iq1_s", GG_IQ1_S, 256, 50, 16384 },
};
const GgType* gg_type(const char* s) {
    if (!s) return nullptr;
    for (const GgType& t : kGgTypes)
        if (!std::strcmp(t.name, s)) return &t;
    return nullptr;
}
int gg_tab_bytes(int t) {
    switch (t) {
    case GG_IQ4_NL: return Gg<GG_IQ4_NL>::TB;
    case GG_IQ2_XXS: return Gg<GG_IQ2_XXS>::TB;
    case GG_IQ1_S: return Gg<GG_IQ1_S>::TB;
    default: return 0;
    }
}
long long gg_r16(long long v) { return (v + 15) / 16 * 16; }

/* The activation rows staged whole in LDS: a row is K floats plus a pad of 4 every 32 (XR), and
 * as many rows as fit 36 KiB, at most `xm` (0 when one row does not fit). Past that a pass's rows
 * are staged in chunks of KC values, a multiple of 1024 (32 units of 32), as many as fit the same
 * 36 KiB for `xm` rows. Returns the buffer's floats. */
long long gg_xbuf(int xm, long long K, int* xlm, int* xr, int* kc) {
    *xr = (int)(K + K / 8);
    const long long f = 9216 / (K + K / 8);
    *xlm = (int)(f < xm ? f : xm);
    long long c = 9216 / ((long long)xm * 1152);
    if (c < 1) c = 1;
    const long long kr = (K + 1023) / 1024 * 1024;
    *kc = (int)(1024LL * c < kr ? 1024LL * c : kr);
    const long long whole = (long long)*xlm * *xr, chunk = (long long)xm * (*kc + *kc / 8);
    return *xlm >= xm ? whole : (whole > chunk ? whole : chunk);
}

bool gg_inner1(const RadTensor* t) { return t->rank < 2 || t->shape[t->rank - 1] == 1 || t->stride[t->rank - 1] == 1; }
bool gg_al16(const void* p, long long ld) { return ((uintptr_t)p & 15u) == 0 && ld % 8 == 0; }

template <int T>
int gg_launch_gemv_t(RadStream s, int rpw, bool moe, bool f32out, const GgGemvArgs& A, unsigned grid,
                     unsigned lds) {
    if (moe) {
        if (rpw == 2 && T != GG_F32)
            return R4D_EMIT(s, (gg_gemv_kernel<T, (T == GG_F32 ? 1 : 2), true, uint16_t>), dim3(grid), dim3(kGgThreads), lds, A);
        return R4D_EMIT(s, (gg_gemv_kernel<T, 1, true, uint16_t>), dim3(grid), dim3(kGgThreads), lds, A);
    }
    if (f32out) {
        if (rpw == 2 && T != GG_F32)
            return R4D_EMIT(s, (gg_gemv_kernel<T, (T == GG_F32 ? 1 : 2), false, float>), dim3(grid), dim3(kGgThreads), lds, A);
        return R4D_EMIT(s, (gg_gemv_kernel<T, 1, false, float>), dim3(grid), dim3(kGgThreads), lds, A);
    }
    if (rpw == 2 && T != GG_F32)
        return R4D_EMIT(s, (gg_gemv_kernel<T, (T == GG_F32 ? 1 : 2), false, uint16_t>), dim3(grid), dim3(kGgThreads), lds, A);
    return R4D_EMIT(s, (gg_gemv_kernel<T, 1, false, uint16_t>), dim3(grid), dim3(kGgThreads), lds, A);
}

template <int T>
int gg_launch_tiled_t(RadStream s, int bm, bool moe, bool f32out, const GgTiledArgs& A, dim3 grid,
                      unsigned lds) {
    if (bm == 32) {
        if (moe) return R4D_EMIT(s, (gg_tiled_kernel<T, 32, true, uint16_t>), grid, dim3(kGgThreads), lds, A);
        if (f32out) return R4D_EMIT(s, (gg_tiled_kernel<T, 32, false, float>), grid, dim3(kGgThreads), lds, A);
        return R4D_EMIT(s, (gg_tiled_kernel<T, 32, false, uint16_t>), grid, dim3(kGgThreads), lds, A);
    }
    if (moe) return R4D_EMIT(s, (gg_tiled_kernel<T, 128, true, uint16_t>), grid, dim3(kGgThreads), lds, A);
    if (f32out) return R4D_EMIT(s, (gg_tiled_kernel<T, 128, false, float>), grid, dim3(kGgThreads), lds, A);
    return R4D_EMIT(s, (gg_tiled_kernel<T, 128, false, uint16_t>), grid, dim3(kGgThreads), lds, A);
}

int gg_launch_gemv(RadStream s, int ty, int rpw, bool moe, bool f32out, const GgGemvArgs& A,
                   unsigned grid, unsigned lds) {
#define GG_CALL_GEMV(T) gg_launch_gemv_t<T>(s, rpw, moe, f32out, A, grid, lds)
    switch (ty) {
    case GG_Q8_0: return GG_CALL_GEMV(GG_Q8_0);
    case GG_Q5_K: return GG_CALL_GEMV(GG_Q5_K);
    case GG_Q6_K: return GG_CALL_GEMV(GG_Q6_K);
    case GG_IQ4_NL: return GG_CALL_GEMV(GG_IQ4_NL);
    case GG_IQ2_XXS: return GG_CALL_GEMV(GG_IQ2_XXS);
    case GG_IQ1_S: return GG_CALL_GEMV(GG_IQ1_S);
    case GG_F32: return GG_CALL_GEMV(GG_F32);
    default: return R4D_NO(RAD_E_DTYPE);
    }
#undef GG_CALL_GEMV
}

int gg_launch_tiled(RadStream s, int ty, int bm, bool moe, bool f32out, const GgTiledArgs& A,
                    dim3 grid, unsigned lds) {
#define GG_CALL_TILED(T) gg_launch_tiled_t<T>(s, bm, moe, f32out, A, grid, lds)
    switch (ty) {
    case GG_Q8_0: return GG_CALL_TILED(GG_Q8_0);
    case GG_Q5_K: return GG_CALL_TILED(GG_Q5_K);
    case GG_Q6_K: return GG_CALL_TILED(GG_Q6_K);
    case GG_IQ4_NL: return GG_CALL_TILED(GG_IQ4_NL);
    case GG_IQ2_XXS: return GG_CALL_TILED(GG_IQ2_XXS);
    case GG_IQ1_S: return GG_CALL_TILED(GG_IQ1_S);
    case GG_F32: return GG_CALL_TILED(GG_F32);
    default: return R4D_NO(RAD_E_DTYPE);
    }
#undef GG_CALL_TILED
}

int gg_launch_embed(RadStream s, int ty, const int32_t* tok, const uint8_t* w, long long w_ld,
                    uint16_t* x, long long x_ld, int M, int E, int V, long long voff, float mult) {
    const unsigned grid = (unsigned)(M < 4096 ? M : 4096);
    const unsigned lds = (unsigned)gg_r16(gg_tab_bytes(ty));
#define GG_CALL_EMBED(T) \
    R4D_EMIT(s, gg_embed_kernel<T>, dim3(grid), dim3(kGgThreads), lds, tok, w, w_ld, x, x_ld, M, E, V, voff, mult)
    switch (ty) {
    case GG_Q8_0: return GG_CALL_EMBED(GG_Q8_0);
    case GG_Q5_K: return GG_CALL_EMBED(GG_Q5_K);
    case GG_Q6_K: return GG_CALL_EMBED(GG_Q6_K);
    case GG_IQ4_NL: return GG_CALL_EMBED(GG_IQ4_NL);
    case GG_IQ2_XXS: return GG_CALL_EMBED(GG_IQ2_XXS);
    case GG_IQ1_S: return GG_CALL_EMBED(GG_IQ1_S);
    case GG_F32: return GG_CALL_EMBED(GG_F32);
    default: return R4D_NO(RAD_E_DTYPE);
    }
#undef GG_CALL_EMBED
}

/* The weight operand of a linear: native blocks (u8, [N, K] declared or [N, row bytes]) or the
 * float logical form [N, K]. Sets the kernel type and the row stride in bytes. */
int gg_weight2(const RadTensor* w, const GgType* gt, long long N, long long K, int* ty, long long* ld) {
    if (!w || !w->data || w->rank != 2 || w->shape[0] != N) return R4D_NO(RAD_E_SHAPE);
    const long long rb = K / gt->qk * gt->bb;
    if (w->dtype == RAD_U8) {
        if (w->shape[1] != rb && w->shape[1] != K) return R4D_NO(RAD_E_SHAPE);
        if (gt->t == GG_Q5_K && ((uintptr_t)w->data & 3u)) return R4D_NO(RAD_E_STRIDE);
        if ((uintptr_t)w->data & 1u) return R4D_NO(RAD_E_STRIDE);
        *ty = gt->t;
        *ld = rb;
        return RAD_OK;
    }
    if (w->dtype == RAD_F32) {
        if (w->shape[1] != K || !gg_inner1(w) || ((uintptr_t)w->data & 3u)) return R4D_NO(RAD_E_SHAPE);
        *ty = GG_F32;
        *ld = (long long)w->stride[0] * 4;
        return RAD_OK;
    }
    return R4D_NO(RAD_E_DTYPE);
}

/* gemm_nt_ggml and logits_gemm_ggml: y[M, N] = x[M, K] . w[N, K]^T. */
int gg_gemm(const RadArgs* a, RadStream s, const char* nN, const char* nK, bool logits, bool gemv) {
    if (!a || a->n_t < 3) return R4D_NO(RAD_E_INVAL);
    const RadTensor *x = r4d_opt(a, 0), *w = r4d_opt(a, 1), *y = r4d_opt(a, 2);
    if (!x || !w || !y || !x->data || !w->data || !y->data) return R4D_NO(RAD_E_INVAL);
    const GgType* gt = gg_type(r4d_gets(a, "type"));
    if (!gt) return R4D_NO(RAD_E_DTYPE);
    const long long N = r4d_geti_or(a, nN, 0), K = r4d_geti_or(a, nK, 0);
    if (N <= 0 || K <= 0 || K % gt->qk || N > 0x7fffffffLL || K > 0x7fffffffLL) return R4D_NO(RAD_E_SHAPE);
    if (x->rank != 2 || x->dtype != RAD_BF16 || x->shape[1] != K || !gg_inner1(x)) return R4D_NO(RAD_E_SHAPE);
    const long long M = x->shape[0], Mb = r4d_geti_or(a, "M", 0);
    if (M <= 0 || M > 0x7fffffffLL || (Mb > 0 && M > Mb)) return R4D_NO(RAD_E_SHAPE);
    if (y->rank != 2 || y->dtype != (logits ? (uint32_t)RAD_F32 : (uint32_t)RAD_BF16) ||
        y->shape[1] != N || y->shape[0] < M || !gg_inner1(y))
        return R4D_NO(RAD_E_SHAPE);
    int ty = 0;
    long long w_ld = 0;
    const int rc = gg_weight2(w, gt, N, K, &ty, &w_ld);
    if (rc != RAD_OK) return rc;
    const long long x_ld = M > 1 ? x->stride[0] : K, y_ld = M > 1 ? y->stride[0] : N;
    const int x_al = gg_al16(x->data, x_ld) ? 1 : 0;
    const long long tb = gg_r16(gg_tab_bytes(ty));
    if (gemv && M <= 16) {
        GgGemvArgs A{};
        A.x = (const uint16_t*)x->data; A.x_ld = x_ld;
        A.w = (const uint8_t*)w->data; A.wtab = nullptr; A.w_ld = w_ld; A.w_es = 0;
        A.y = y->data; A.y_ld = y_ld;
        A.M = (int)M; A.N = (int)N; A.K = (int)K;
        A.XM = (int)(M < kGgXM ? M : kGgXM);
        const long long xbuf = gg_xbuf(A.XM, K, &A.XLM, &A.XR, &A.KC);
        const int rpw = (M >= 3 && ty != GG_F32 && (N + 15) / 16 >= 128) ? 2 : 1;
        const long long nrg = (N + 8 * rpw - 1) / (8 * rpw);
        A.rgpi = 1; A.ipe = (int)nrg;
        A.x_al = x_al;
        A.live_off = (int)tb; A.x_off = (int)tb;
        const long long lds = tb + xbuf * 4;
        const unsigned grid = (unsigned)(nrg < 256 ? nrg : 256);
        return gg_launch_gemv(s, ty, rpw, false, logits, A, grid, (unsigned)lds);
    }
    GgTiledArgs A{};
    A.x = (const uint16_t*)x->data; A.x_ld = x_ld;
    A.w = (const uint8_t*)w->data; A.wtab = nullptr; A.w_ld = w_ld; A.w_es = 0;
    A.y = y->data; A.y_ld = y_ld;
    A.M = (int)M; A.N = (int)N; A.K = (int)K;
    A.x_al = x_al; A.tab_bytes = (int)tb;
    const long long gy = (N + kTN - 1) / kTN;
    if (gy > 65535) return R4D_NO(RAD_E_SHAPE);
    const int bm = M <= 64 ? 32 : 128;
    const dim3 grid((unsigned)((M + bm - 1) / bm), (unsigned)gy);
    return gg_launch_tiled(s, ty, bm, false, logits, A, grid, (unsigned)(tb + 32 * (kTP + bm + 4) * 4));
}

/* moe_gemm_ggml: y[i] = a[row(i)] . w[e(i)]^T over the expert-sorted rows. */
int gg_moe(const RadArgs* a, RadStream s, bool gemv) {
    if (!a || a->n_t < 5) return R4D_NO(RAD_E_INVAL);
    const RadTensor *A_ = r4d_opt(a, 0), *W = r4d_opt(a, 1), *so = r4d_opt(a, 2), *of = r4d_opt(a, 3),
                    *Y = r4d_opt(a, 4);
    if (!A_ || !W || !so || !of || !Y || !A_->data || !W->data || !so->data || !of->data || !Y->data)
        return R4D_NO(RAD_E_INVAL);
    const GgType* gt = gg_type(r4d_gets(a, "type"));
    if (!gt) return R4D_NO(RAD_E_DTYPE);
    const long long N = r4d_geti_or(a, "N", 0), K = r4d_geti_or(a, "K", 0);
    const long long ne = r4d_geti_or(a, "n_expert", 0), top_k = r4d_geti_or(a, "top_k", 0);
    const char* ord = r4d_gets(a, "a_order");
    const bool a_sorted = ord && !std::strcmp(ord, "sorted");
    if (ord && !a_sorted && std::strcmp(ord, "token")) return R4D_NO(RAD_E_UNSUPPORTED);
    if (N <= 0 || K <= 0 || K % gt->qk || ne <= 0 || ne > kGgMaxExpert || top_k <= 0 ||
        N > 0x7fffffffLL || K > 0x7fffffffLL)
        return R4D_NO(RAD_E_SHAPE);
    if (A_->rank != 2 || A_->dtype != RAD_BF16 || A_->shape[1] != K || !gg_inner1(A_)) return R4D_NO(RAD_E_SHAPE);
    if (Y->rank != 2 || Y->dtype != RAD_BF16 || Y->shape[1] != N || !gg_inner1(Y)) return R4D_NO(RAD_E_SHAPE);
    const long long T = Y->shape[0], AR = A_->shape[0];
    if (T <= 0 || AR <= 0 || T > 0x7fffffffLL || AR > 0x7fffffffLL) return R4D_NO(RAD_E_SHAPE);
    if ((so->dtype != RAD_I32 && so->dtype != RAD_U32) || (of->dtype != RAD_I32 && of->dtype != RAD_U32) ||
        !r4d_contig(so) || !r4d_contig(of))
        return R4D_NO(RAD_E_DTYPE);
    if (r4d_numel(so) < T || r4d_numel(of) < ne + 1) return R4D_NO(RAD_E_SHAPE);
    if (W->rank != 3 || W->shape[0] < ne || W->shape[1] != N) return R4D_NO(RAD_E_SHAPE);
    const long long rb = K / gt->qk * gt->bb;
    int ty = 0;
    long long w_ld = 0, w_es = 0;
    const bool table = W->stride[0] == 0;
    if (W->dtype == RAD_U8) {
        if (W->shape[2] != rb && W->shape[2] != K) return R4D_NO(RAD_E_SHAPE);
        ty = gt->t;
        w_ld = rb;
        w_es = N * rb;
        if (!table && ((uintptr_t)W->data & (gt->t == GG_Q5_K ? 3u : 1u))) return R4D_NO(RAD_E_STRIDE);
    } else if (W->dtype == RAD_F32) {
        if (W->shape[2] != K || W->stride[2] != 1) return R4D_NO(RAD_E_SHAPE);
        ty = GG_F32;
        w_ld = (long long)W->stride[1] * 4;
        w_es = (long long)W->stride[0] * 4;
    } else {
        return R4D_NO(RAD_E_DTYPE);
    }
    const long long x_ld = AR > 1 ? A_->stride[0] : K, y_ld = T > 1 ? Y->stride[0] : N;
    const long long tb = gg_r16(gg_tab_bytes(ty));
    const long long tokens = a_sorted ? (T + top_k - 1) / top_k : AR;
    const long long L = ne < T ? ne : T;       /* experts that can have rows */
    if (gemv && tokens <= 16) {
        GgGemvArgs A{};
        A.x = (const uint16_t*)A_->data; A.x_ld = x_ld;
        A.w = table ? nullptr : (const uint8_t*)W->data;
        A.wtab = table ? (const uint8_t* const*)W->data : nullptr;
        A.w_ld = w_ld; A.w_es = w_es;
        A.y = Y->data; A.y_ld = y_ld;
        A.sorted = (const int32_t*)so->data; A.off = (const int32_t*)of->data;
        A.M = (int)T; A.N = (int)N; A.K = (int)K;
        /* An expert's run is at most a row a token under a valid routing (top-k picks distinct
         * experts); a longer one takes more passes. */
        A.XM = (int)(tokens < kGgXM ? (tokens < 1 ? 1 : tokens) : kGgXM);
        const long long xbuf = gg_xbuf(A.XM, K, &A.XLM, &A.XR, &A.KC);
        /* Two weight rows a wave on wide experts of the multi-word unit types (twice the loads in
         * flight); the I-quants' three-word units already keep eight in flight a lane. */
        const int rpw = (ty != GG_F32 && ty != GG_IQ1_S && ty != GG_IQ2_XXS && N >= 1024) ? 2 : 1;
        const long long nrg = (N + 8 * rpw - 1) / (8 * rpw);
        long long rgpi = (L * nrg + 255) / 256;
        if (rgpi < 1) rgpi = 1;
        const long long ipe = (nrg + rgpi - 1) / rgpi;
        A.rgpi = (int)rgpi; A.ipe = (int)ipe;
        A.n_expert = (int)ne; A.top_k = (int)top_k; A.a_sorted = a_sorted ? 1 : 0; A.AR = (int)AR;
        A.x_al = gg_al16(A_->data, x_ld) ? 1 : 0;
        A.live_off = (int)tb;
        A.x_off = (int)(tb + gg_r16(ne * 4));
        const long long lds = A.x_off + xbuf * 4;
        const long long items = L * ipe;
        const unsigned grid = (unsigned)(items < 256 ? items : 256);
        return gg_launch_gemv(s, ty, rpw, true, false, A, grid, (unsigned)lds);
    }
    GgTiledArgs A{};
    A.x = (const uint16_t*)A_->data; A.x_ld = x_ld;
    A.w = table ? nullptr : (const uint8_t*)W->data;
    A.wtab = table ? (const uint8_t* const*)W->data : nullptr;
    A.w_ld = w_ld; A.w_es = w_es;
    A.y = Y->data; A.y_ld = y_ld;
    A.sorted = (const int32_t*)so->data; A.off = (const int32_t*)of->data;
    A.M = (int)T; A.N = (int)N; A.K = (int)K;
    A.n_expert = (int)ne; A.top_k = (int)top_k; A.a_sorted = a_sorted ? 1 : 0; A.AR = (int)AR;
    A.x_al = gg_al16(A_->data, x_ld) ? 1 : 0;
    A.tab_bytes = (int)tb;
    /* 32-row tiles while the experts' runs average under 64 rows (prefill over many experts). */
    const int bm = T < 64 * L ? 32 : 128;
    const long long gx = (T + bm - 1) / bm + L, gy = (N + kTN - 1) / kTN;
    if (gy > 65535 || gx > 0x7fffffffLL) return R4D_NO(RAD_E_SHAPE);
    return gg_launch_tiled(s, ty, bm, true, false, A, dim3((unsigned)gx, (unsigned)gy),
                           (unsigned)(tb + 32 * (kTP + bm + 4) * 4));
}

}  // namespace

extern "C" int r4d_rad_gemm_nt_ggml_gemv(const RadArgs* a, RadStream s) { return gg_gemm(a, s, "N", "K", false, true); }
extern "C" int r4d_rad_gemm_nt_ggml_tiled(const RadArgs* a, RadStream s) { return gg_gemm(a, s, "N", "K", false, false); }
extern "C" int r4d_rad_logits_gemm_ggml_gemv(const RadArgs* a, RadStream s) {
    return gg_gemm(a, s, "n_vocab", "n_embd", true, true);
}
extern "C" int r4d_rad_logits_gemm_ggml_tiled(const RadArgs* a, RadStream s) {
    return gg_gemm(a, s, "n_vocab", "n_embd", true, false);
}
extern "C" int r4d_rad_moe_gemm_ggml_gemv(const RadArgs* a, RadStream s) { return gg_moe(a, s, true); }
extern "C" int r4d_rad_moe_gemm_ggml_tiled(const RadArgs* a, RadStream s) { return gg_moe(a, s, false); }

/* embed_lookup_ggml: the id's row dequantised, times `mult`, rounded once. A negative id or one
 * outside [vocab_offset, vocab_offset + n_vocab) writes a zero row (libref also refuses an id past
 * the vocabulary on a rank holding all of it, which a device launch cannot see). */
extern "C" int r4d_rad_embed_lookup_ggml(const RadArgs* a, RadStream s) {
    if (!a || a->n_t < 3) return R4D_NO(RAD_E_INVAL);
    const RadTensor *tok = r4d_opt(a, 0), *w = r4d_opt(a, 1), *x = r4d_opt(a, 2);
    if (!tok || !w || !x || !tok->data || !w->data || !x->data) return R4D_NO(RAD_E_INVAL);
    const GgType* gt = gg_type(r4d_gets(a, "type"));
    if (!gt) return R4D_NO(RAD_E_DTYPE);
    const long long E = r4d_geti_or(a, "n_embd", 0), V = r4d_geti_or(a, "n_vocab", 0);
    const long long voff = r4d_geti_or(a, "vocab_offset", 0);
    if (E <= 0 || V <= 0 || voff < 0 || E % gt->qk || E > 0x7fffffffLL || V > 0x7fffffffLL)
        return R4D_NO(RAD_E_SHAPE);
    if (tok->dtype != RAD_I32 || !r4d_contig(tok)) return R4D_NO(RAD_E_DTYPE);
    if (x->dtype != RAD_BF16) return R4D_NO(RAD_E_DTYPE);
    if (!w->data || w->rank != 2 || w->shape[0] < V) return R4D_NO(RAD_E_SHAPE);
    const long long rb = E / gt->qk * gt->bb;
    int ty = 0;
    long long w_ld = 0;
    if (w->dtype == RAD_U8) {
        if (w->shape[1] != rb && w->shape[1] != E) return R4D_NO(RAD_E_SHAPE);
        if ((uintptr_t)w->data & (gt->t == GG_Q5_K ? 3u : 1u)) return R4D_NO(RAD_E_STRIDE);
        ty = gt->t;
        w_ld = rb;
    } else if (w->dtype == RAD_F32) {
        if (w->shape[1] != E || !gg_inner1(w)) return R4D_NO(RAD_E_SHAPE);
        ty = GG_F32;
        w_ld = (long long)w->stride[0] * 4;
    } else {
        return R4D_NO(RAD_E_DTYPE);
    }
    long long M = 0;
    const long long x_ld = r4d_rows_pitch(x, E, &M);
    if (x_ld < 0) return R4D_NO(RAD_E_STRIDE);
    if (M <= 0 || M > 0x7fffffffLL || r4d_numel(tok) < M) return R4D_NO(RAD_E_SHAPE);
    const float mult = (float)r4d_getf(a, "mult", 1.0);
    return gg_launch_embed(s, ty, (const int32_t*)tok->data, (const uint8_t*)w->data, w_ld,
                           (uint16_t*)x->data, x_ld, (int)M, (int)E, (int)V, voff, mult);
}
