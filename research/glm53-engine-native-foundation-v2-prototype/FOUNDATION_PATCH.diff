+    for(auto n:{q.device_bytes,q.pinned_bytes,q.mapped_bytes})if(!add(requested,n))return false;
+    for(auto n:{q.device_page_bytes,q.pinned_page_bytes,q.mapped_page_bytes})if(!add(rounded,n))return false;
