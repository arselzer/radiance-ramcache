+                    result.application_stream_present|=rank.glm_compute.get()!=nullptr||rank.mover.native_record_compute_stream()!=nullptr||rank.ctx.cur_stream()!=nullptr;
+                    result.context_initialized|=rank.ctx.program()!=nullptr;
