+        for(size_t i=0;i<unique.size();++i){const auto n=unique[i];auto& cell=cells[n];inc(counters.cell_lookups);
+            work[i]=cell.weak.lock();if(work[i])inc(cell.hot?counters.hot_hits:counters.cold_hits);
