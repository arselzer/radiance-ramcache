# Proposed Qwen3.8-Flash-Next FP8-expert comparison; conversion NOT executed.
# Source: the original BF16 checkpoint, matching the provenance of the reused .rad.
# Derived from Radiance qwen4exp-w4nl64-i8-hc8m.recipe; only the generic expert rule changes.
# E4M3 expert codes, BF16 scales per128x128block, no rotation/codebook/GPTQ calibration.
# Ten protected BF16 expert exceptions and every nonexpert rule remain unchanged.
# Use --reuse only with a verified container derived from the SAME original checkpoint.
# Unchanged weights can then be copied; new expert values must come from BF16 source weights.
# This is NOT a precision upgrade of an existing four-bit file and has no measured quality/speed claim.
# First rule that matches a weight wins. First invoke rad-convert with --plan-only -v.

blk.34.ffn_*_exps.407.weight         cast dtype=bf16
blk.34.ffn_*_exps.496.weight         cast dtype=bf16
blk.44.ffn_*_exps.292.weight         cast dtype=bf16
blk.44.ffn_*_exps.350.weight         cast dtype=bf16
blk.46.ffn_*_exps.290.weight         cast dtype=bf16
blk.46.ffn_*_exps.392.weight         cast dtype=bf16
blk.47.ffn_*_exps.122.weight         cast dtype=bf16
blk.47.ffn_*_exps.143.weight         cast dtype=bf16
blk.47.ffn_*_exps.399.weight         cast dtype=bf16
blk.47.ffn_*_exps.445.weight         cast dtype=bf16
blk.*.ffn_*_exps.*.weight            rtn codes=fp8_e4m3 block=128x128 scale=bf16
*_hc_down.weight                     rtn  codes=fp8_e4m3 group=128 scale=f32
*_hc_up.weight                       rtn  codes=fp8_e4m3 group=80 scale=f32
mtp.fc_hidden.weight                 rtn  codes=fp8_e4m3 group=128 scale=f32
mtp.fc_embedding.weight              rtn  codes=fp8_e4m3 group=128 scale=f32
blk.*.attn_qg.weight                 rtn  codes=i8 group=128 scale=bf16 clamp=sym rule=search
blk.*.attn_k.weight                  rtn  codes=i8 group=128 scale=bf16 clamp=sym rule=search
blk.*.attn_v.weight                  rtn  codes=i8 group=128 scale=bf16 clamp=sym rule=search
blk.*.attn_output.weight             rtn  codes=i8 group=128 scale=bf16 clamp=sym rule=search
blk.*.ssm_inz.weight                 rtn  codes=i8 group=128 scale=bf16 clamp=sym rule=search
blk.*.ssm_out.weight                 rtn  codes=i8 group=128 scale=bf16 clamp=sym rule=search
blk.*.ffn_gate_up_shexp.weight       rtn  codes=i8 group=128 scale=bf16 clamp=sym rule=search
blk.*.ffn_down_shexp.weight          rtn  codes=i8 group=128 scale=bf16 clamp=sym rule=search
output.weight                        rtn  codes=i8 group=128 scale=bf16 clamp=sym rule=search
blk.*.ple_ngram.weight               rtn  codes=fp8_e4m3 block=*x* scale=bf16 rule=fixed scale_value=1.99317932128906e-4
mtp.draft_head.weight                rtn  codes=u2 zero=u8 group=128 scale=f16
