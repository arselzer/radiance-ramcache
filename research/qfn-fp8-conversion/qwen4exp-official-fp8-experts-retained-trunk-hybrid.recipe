# Explicit hybrid candidate: official FP8 experts plus unchanged retained current .rad planes.
# Derived from the actual recorded production recipe; only generic expert GPTQ rule removed.
# Native experts are unmatched raw code/scale copies. All25 retained rules keep exact text.
# Requires verified scale overlay, empty selector override, strict per-entry reuse and all-plane equality.
# Full model plan/conversion have not been run. Do not use this as the BF16-source RTN recipe.
blk.34.ffn_*_exps.407.weight cast dtype=bf16
blk.34.ffn_*_exps.496.weight cast dtype=bf16
blk.44.ffn_*_exps.292.weight cast dtype=bf16
blk.44.ffn_*_exps.350.weight cast dtype=bf16
